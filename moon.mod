name = "haol-05/moonloom"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/haol-05/moonloom"

license = "Apache-2.0"

description = "Pipeline query engine over semi-structured text: CSV, JSON, logfmt, access logs and syslog in, query plans, indexes and aggregations out"

keywords = [
  "query-engine",
  "log-analysis",
  "semi-structured-data",
  "csv",
  "json",
  "logfmt",
  "syslog",
  "index",
  "aggregation",
]

preferred_target = "wasm"
